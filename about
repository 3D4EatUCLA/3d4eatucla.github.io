    <script>
        const car = document.getElementById('board-carousel');
        let timer;

        // Handles both forward (1) and backward (-1) movement with looping
        const move = (dir = 1) => {
            const w = car.offsetWidth, len = car.children.length;
            const nextIdx = (Math.round(car.scrollLeft / w) + dir + len) % len;
            car.scrollTo({ left: nextIdx * w, behavior: 'smooth' });
        };

        const play = () => timer = setInterval(move, 4000);
        const reset = () => { clearInterval(timer); play(); };

        // Button clicks
        document.querySelector('.carousel-btn.prev').onclick = () => { move(-1); reset(); };
        document.querySelector('.carousel-btn.next').onclick = () => { move(1); reset(); };

        // Pause on hover/touch, resume on leave
        ['mouseenter', 'touchstart'].forEach(e => car.addEventListener(e, () => clearInterval(timer), { passive: true }));
        ['mouseleave', 'touchend'].forEach(e => car.addEventListener(e, play));

        play(); // Start autoplay on load
    </script>
    <script src="assets/js/allpages.js" defer></script>
