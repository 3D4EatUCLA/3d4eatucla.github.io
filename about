    <script>
      (() => {
        const viewport = document.querySelector('[data-lineup-menu]');
        if (!viewport) return;

        const groups = [...viewport.querySelectorAll('[data-menu-group]')];
        const rows = [...document.querySelectorAll('[data-position-group]')];
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let activeIndex = 0;
        let timer;

        const showGroup = (index) => {
          activeIndex = (index + groups.length) % groups.length;
          groups.forEach((group, i) => {
            group.open = i === activeIndex;
          });
          rows.forEach((row, i) => row.classList.toggle('is-active', i === activeIndex));
        };

        const stop = () => window.clearInterval(timer);
        const play = () => {
          stop();
          if (!reduceMotion) timer = window.setInterval(() => showGroup(activeIndex + 1), 3500);
        };

        groups.forEach((group, index) => {
          group.querySelector('summary').addEventListener('click', event => {
            event.preventDefault();
            showGroup(index);
            play();
          });
        });

        const menu = viewport.closest('.position-menu');
        menu.addEventListener('mouseenter', stop);
        menu.addEventListener('mouseleave', play);
        menu.addEventListener('focusin', stop);
        menu.addEventListener('focusout', play);
        showGroup(0);
        play();
      })();
    </script>
    <script src="assets/js/allpages.js" defer></script>
